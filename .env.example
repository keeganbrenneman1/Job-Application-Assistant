# Claude API (Call 1 research + Call 2 generation)
ANTHROPIC_API_KEY=
# Optional model override, defaults to claude-sonnet-5
ANTHROPIC_MODEL=

# Set to "true" to skip live Claude calls and use the hard-coded example
# response instead (also used automatically if ANTHROPIC_API_KEY is unset).
MOCK_MODE=false

# Supabase (generated-prep storage only — resumes are never stored).
# Without these, the app falls back to an in-memory store that resets on
# every server restart, which is fine for local iteration but not for
# anything you want to persist. Run src/lib/supabase/schema.sql against a
# new Supabase project, then fill these in from Project Settings > API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
